{
  // 訂單秘書官網 — Cloudflare Workers Static Assets（純靜態，沒有 Worker 程式碼）
  //
  //   npx wrangler deploy        部署
  //   npx wrangler dev           本機預覽（也可以直接用 python3 -m http.server，見 README）
  //
  // 為什麼是 Workers 不是 Pages：Pages 已進入維護模式，Cloudflare 現在把
  // Workers Static Assets 當成靜態站的正規做法（版本歷史、rollback、之後要加
  // 動態邏輯時直接補一個 main 進來就好）。
  "name": "structaly-web",
  "compatibility_date": "2026-08-25",

  // 保留 *.workers.dev 預覽網址。不寫這行的話 wrangler 會預設關掉它，
  // 之後 DNS 或自訂網域出問題時就沒有可用來驗證來源站的管道了。
  "workers_dev": true,

  "assets": {
    // 整個 repo 根目錄就是網站根目錄；不該上線的檔案列在 .assetsignore。
    "directory": ".",

    // ── 這一行是整份設定裡最要緊的 ──────────────────────────────────────
    // 全站的內部連結與 canonical 都是「不帶結尾斜線」的形式（/trades/meat），
    // 而 Cloudflare 的預設值 auto-trailing-slash 會把資料夾索引頁導向
    // /trades/meat/（帶斜線），六個產業頁就會全部變成 307 轉址、canonical 與
    // 實際 200 的網址對不上。drop-trailing-slash 才是與現有網址一致的模式。
    // 改這個值以前先確認 canonical 也要跟著改。
    "html_handling": "drop-trailing-slash",

    // 找不到的路徑回傳根目錄的 404.html。這不影響 /trades/meat 這類資料夾
    // 索引頁；資料夾索引與斜線轉址仍由上面的 html_handling 負責。
    "not_found_handling": "404-page"
  },

  // ── 自訂網域 structaly.com ────────────────────────────────────────────────
  // 已啟用。structaly.com 的 NS 已於 2026-09-04 切到 Cloudflare
  // （ada/mitch.ns.cloudflare.com），zone active，wrangler 會自動維護 DNS 與憑證。
  //
  // 等 structaly.com 的 NS 換到 Cloudflare、zone 變成 active 之後，
  // 把下面這段的註解拿掉再 `npx wrangler deploy`，wrangler 會自動建好 DNS 記錄
  // 與憑證，不用手動去 dashboard 加。
  //
  // 用 Workers Routes 而非 custom_domain：zone 建立時 Cloudflare 自動掃描匯入了
  // 舊的 Render 記錄（A @ -> 216.24.57.1、www -> structaly-pify.onrender.com），
  // custom_domain 會因為「hostname already has externally managed DNS records」被拒。
  // Routes 不要求刪記錄——只要該 hostname 有一筆「橘雲代理」的記錄，route 就會在
  // 到達來源站之前攔截請求，Render 永遠不會被打到。效果與 custom_domain 相同。
  "routes": [
    { "pattern": "structaly.com/*",     "zone_name": "structaly.com" },
    { "pattern": "www.structaly.com/*", "zone_name": "structaly.com" }
  ],
  //
  // www 綁上去之後記得再加一條 Redirect Rule 把 www 301 到 apex
  // （站內 canonical 全部寫的是 apex，兩邊都回 200 會變成重複內容）。

  "observability": { "enabled": true }
}
